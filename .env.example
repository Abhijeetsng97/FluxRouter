# FluxRouter keys — copy this file to `.env` and fill in the values.
# `.env` is gitignored; never commit real keys.
#
# Precedence: real environment variables always win over this file.
# `.env.local` (also gitignored) takes precedence over `.env` if you need per-machine overrides.

# Required — primary generation lane (Ollama Cloud, OpenAI-compatible)
OLLAMA_API_KEY= 

# Required — Jev classification (TypeSafe System One API)
TYPESAFE_API_KEY=

# Optional — failover/burst lane + LLM-judge cross-checks.
# Works fine without it; failover then uses Ollama tiers only.
OPENROUTER_API_KEY=

# Optional — require Bearer auth on the proxy.
# Mandatory if you ever bind a non-loopback host.
# FLUX_AUTH_TOKEN=
